# NetHub 配置模板
#
# 用法：把本文件复制成 config.yaml（同目录），再把上游和网段改成你自己的。
#
# ⚠ forward 里含上游凭据（auth= 是「用户:口令」的 base64），
#   所以真正的 config.yaml 是敏感文件：不要提交进 git、不要贴进聊天/工单。

relay: 127.0.0.1:0          # relay 监听地址；端口写 0 = 自动分配（推荐，不占固定端口）

chains:                     # 每条链 = 一个上游代理（程序内置实现，不需要 gost.exe）
  - name: proxy-a
    forward: socks5+tls://YOUR-HOST:10080?auth=YOUR_BASE64_OF_user:pass
    note: 示例链路 A（备注会显示在规则页的「说明」列）
  - name: proxy-b
    forwards:                     # 多个上游：前面的坏了自动换下一个
      - socks5+tls://YOUR-HOST-A:33001?auth=YOUR_BASE64_OF_user:pass
      - socks5+tls://YOUR-HOST-B:33002?auth=YOUR_BASE64_OF_user:pass
    strategy: failover            # failover(默认) | round(轮询) | random(随机)
    probe: 30s                    # 健康探测间隔（只测到代理这一段）；off = 关
# 选写：上游多了可故障转移/负载均衡；不填 strategy/probe 就是单上游 + 30s 探测。
# 支持的写法：
#   socks5+tls://host:port?auth=<base64(user:pass)>   ← 最常见的 gost 风格
#   socks5://user:pass@host:port
#   socks4://host:port      http://host:port      https://host:port

# 路由规则：一条规则 = 名字 + 一组目标 + （可选）一组端口 + 走哪个链
# （形状对齐 Proxifier 的 Rules）自上而下匹配、命中即止；一条规则内任一目标命中即算命中。
#
# 动作有两种：走某条链，或「直连」—— chain 写保留名 direct（界面上选「直连（不走代理）」）。
# 直连 = 不改写、不进隧道；**本机所在的局域网段都应该直连**，否则同事机器 /
# 打印机 / 共享盘会被送进隧道而不可达（异地代理到不了你的局域网）。
routes:
  - name: 本机网段直连         # 先写直连，再写隧道：顺序就是优先级
    targets:
      - 192.168.1.0/24        # 界面上填目标时点「填本机网段」可以自动填进来
    chain: direct
  - name: 排除更新端口          # 端口条件：这个网段走隧道，但 7680（Win 更新 P2P）直连
    targets:
      - 10.0.0.0/24
    ports:                   # 留空 = 任意端口；可写 443、8000-9000
      - 7680
    chain: direct
  - name: 内网 A 段
    targets:
      - 10.0.0.0/24         # CIDR 或单个 IP（单 IP 会自动存成 /32）
      - 10.0.1.0/24
    chain: proxy-a
  - name: 内网 B 段
    targets:
      - 192.168.100.0/24
    chain: proxy-b

hosts:
  manage: false             # true = 由本程序维护 hosts 里的标记区块（你的手写内容不受影响）
  entries:                  # 每行一条：内网IP 域名
    - 10.0.0.10 app.example.com

ui:
  theme: light              # light | dark

tuning:
  # 只读嗅探 TLS SNI / HTTP Host（默认开）。
  # 用途：域名通配（*.his.com）原本只能从明文 DNS 应答里学名字；一旦应用用了
  # 加密 DNS（DoH/DoT）或自带解析器，DNS 层就看不见了，而握手是明文的。
  # 只在写了通配域名规则时才真的启动（没写=零开销）。关掉：tls_sniff_disabled: true
  # tls_sniff_disabled: false
